{
    "name": "superagent",
    "version": "1.0.0",
    "description": "Claude Code terminallerini tek pencerede grid halinde çalıştırır",
    "main": "dist/electron/main.js",
    "scripts": {
        "build": "node scripts/build.mjs",
        "start": "node scripts/build.mjs && electron .",
        "dev": "node scripts/build.mjs && electron .",
        "typecheck": "tsc",
        "dist": "node scripts/build.mjs && electron-builder --win portable"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "dependencies": {
        "@lydell/node-pty": "^1.2.0-beta.15",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/addon-web-links": "^0.12.0",
        "@xterm/addon-webgl": "^0.19.0",
        "@xterm/xterm": "^6.0.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.3",
        "electron": "^44.4.5",
        "electron-builder": "^26.15.3",
        "esbuild": "^0.28.2",
        "typescript": "^7.0.2"
    },
    "build": {
        "appId": "dev.superagent",
        "productName": "SuperAgent",
        "files": [
            "dist/**/*",
            "package.json"
        ],
        "directories": {
            "output": "release"
        },
        "win": {
            "target": "portable"
        },
        "portable": {
            "artifactName": "SuperAgent.exe"
        }
    }
}
